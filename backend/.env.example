DATABASE_URL=sqlite:///./review_agent.db

# Empty LLM_BASE_URL = OpenAI. For a free OpenAI-compatible provider:
# Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/  (model: gemini-flash-latest)
# Groq          : https://api.groq.com/openai/v1                            (model: llama-3.3-70b-versatile)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# GitLab Personal Access Token with "api" scope. Free — create one at
# https://gitlab.com/-/user_settings/personal_access_tokens (or your self-hosted instance).
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

CORS_ORIGINS=["http://localhost:5173"]

# Optional: gate the whole app behind a single shared password in production.
SITE_PASSWORD=
